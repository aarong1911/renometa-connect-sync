# ------------- Functions (Prod defaults) -------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=
APP_LOCAL_URL=

# JWT/crypto
JWT_SECRET=
ENCRYPTION_KEY=
BRIDGE_SHARED_SECRET=
EMAIL_SENDER_API_KEY=
EMAIL_SENDER_USER=
REG_SECRET=
RESEND_API_KEY=

# SMTP (Prod)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Legacy/backward-compatible fallback. SMTP_PASSWORD is canonical — some
# functions (e.g. send-email.ts) read SMTP_PASS instead/in addition, so keep
# both set to the same value until the code is consolidated onto one name.
SMTP_PASS=
SMTP_FROM=

# direct Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=
GMAIL_SMTP_SECURE=

# Twilio (Prod)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Owner/staff number that receives internal SMS alerts (e.g. portal message
# notifications) — see netlify/functions/portal-action.ts.
NOTIFY_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
MISSED_CALL_ENABLED=
CALLER_ID=
TWILIO_WHATSAPP_ENABLED=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_ENABLED=
TWILIO_SMS_NUMBER=
MISSED_CALL_MESSAGE=

# ---- Client-visible (VITE_*) variables ----
# Everything prefixed VITE_ is bundled into the browser JS and is NOT
# secret — never put a real credential/secret behind a VITE_ name.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPI_PUBLIC_KEY=

# AI / Voice
ANTHROPIC_API_KEY=
VAPI_API_KEY=
# Optional but strongly recommended for webhook authentication — verifies
# inbound Vapi webhook requests (see netlify/functions/vapi-webhook.ts).
VAPI_WEBHOOK_SECRET=
VITE_VAPI_SERVER_URL=

VITE_GOOGLE_PLACES_API_KEY=
# Dev-only client flag — enables mock/demo data mode in the browser app
# (see src/lib/mock-mode.ts). Leave unset in production.
VITE_MOCK_MODE=

# ---- OAuth Credentials ----

# Google (Gmail, Calendar, Drive, Ads, Business Profile, Contacts)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_BASE_URL=
GOOGLE_GMAIL_SCOPES=
# Future/planned — Calendar, Drive, Business Profile, and Contacts do not
# yet have a dedicated OAuth flow in code (Calendar sync currently reuses
# the Vapi webhook's GCal token path via ENCRYPTION_KEY instead of these
# scopes). Kept as placeholders for when those integrations are built.
GOOGLE_CAL_SCOPES=
GOOGLE_DRIVE_SCOPES=
GOOGLE_GMB_SCOPES=
GOOGLE_ADS_SCOPES=
GOOGLE_CONTACTS_SCOPES=

# Google Ads OAuth (server-only — do not prefix with VITE_)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=
# Testing/development-only — not read by any production reporting path,
# only relevant when exercising Google Ads test-account tooling locally.
GOOGLE_ADS_TEST_MANAGER_ID=
GOOGLE_ADS_TEST_CUSTOMER_ID=
GOOGLE_ADS_OAUTH_STATE_SECRET=
# App-facing URL the callback redirects the browser back to after OAuth
# finishes — must resolve to an allowed origin (http://localhost:5173 or
# https://connect.renometa.com only; port 9999 is the Netlify Functions
# server, NOT the frontend, and is deliberately not accepted here). Falls
# back to CONNECT_APP_URL, then a safe production default, if unset — but
# CONNECT_APP_URL is commonly set to http://localhost:9999 for local
# `netlify dev`, which is NOT in the allowlist, so local testing needs this
# var set explicitly:
#   Local:      GOOGLE_ADS_POST_CONNECT_URL=http://localhost:5173/settings/integrations
#   Production: GOOGLE_ADS_POST_CONNECT_URL=https://connect.renometa.com/settings/integrations
GOOGLE_ADS_POST_CONNECT_URL=
# Optional — Google Ads API version used for account discovery. Defaults to
# v25 if unset (see netlify/functions/lib/google-ads-api.ts).
GOOGLE_ADS_API_VERSION=

# Microsoft (Outlook, M365 Calendar, Teams) — future/planned, no
# implementation exists in netlify/functions/ yet. Kept as a placeholder.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=
MS_OAUTH_SCOPES=

# Slack — future/planned, no implementation exists in netlify/functions/
# yet. Kept as a placeholder.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_SCOPES=
SLACK_REDIRECT_URI=

# Meta (Facebook/Instagram/WhatsApp) OAuth + Graph API — server-only, do not
# prefix with VITE_. See .claude/skills/meta-integrations/SKILL.md and
# netlify/functions/lib/meta-graph-api.ts.
META_APP_ID=
META_APP_SECRET=
# GET-verification token for the inbound webhook (meta-webhook.ts) — a
# value you choose and register with Meta, not something Meta issues.
META_VERIFY_TOKEN=
META_OAUTH_SCOPES=
VITE_META_REDIRECT_URI=
# HMAC secret for signing the OAuth `state` param. Falls back to
# ENCRYPTION_KEY if unset (see meta-oauth-start.ts / meta-oauth-callback.ts).
META_OAUTH_STATE_SECRET=
# Optional — Graph API version override. Defaults to v21.0 if unset (see
# netlify/functions/lib/meta-graph-api.ts). Only new Phase 1A code
# (meta-ads-accounts.ts, meta-ads-select-account.ts) reads this constant —
# pre-existing Meta OAuth/webhook/messaging code still hardcodes v21.0.
META_GRAPH_API_VERSION=
# Base URL used for the Meta OAuth redirect during local/ngrok testing
# (see meta-oauth-start.ts / meta-oauth-callback.ts). Falls back to the
# Netlify-provided URL when unset.
META_OAUTH_BASE_URL=

# AWS (SES)
AWS_REGION=
# Fallback alias for AWS_REGION, read by estimate-send.ts / change-order-send.ts.
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
CONNECT_APP_URL=

# Fallback aliases used only by the estimate/change-order email send flows
# (netlify/functions/estimate-send.ts, netlify/functions/change-order-send.ts).
# These are NOT the preferred/primary names — set SES_FROM_EMAIL,
# SES_REPLY_TO_EMAIL, and CONNECT_APP_URL instead; these exist only as a
# fallback chain in that code path.
SMTP_FROM_EMAIL=
FROM_EMAIL=
REPLY_TO_EMAIL=
APP_URL=

# Stripe
# Client-visible/non-secret — safe to expose in the browser bundle.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Make.com webhooks — optional feature integrations fired from
# netlify/functions/vapi-webhook.ts after a call ends / a tool is invoked.
MAKE_CALL_ENDED_WEBHOOK=
MAKE_TOOL_CALL_WEBHOOK=

# WhatsApp template config — used by netlify/functions/send-inbox-message.ts
# for outbound WhatsApp Cloud API template messages. Optional; both have
# hardcoded defaults in code if unset.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=

# ---- Netlify/runtime-provided variables — do not set manually ----
# These are supplied automatically by the Netlify build/runtime environment
# and are read as fallbacks in several functions. Do not add them to your
# local .env; Netlify CLI (`netlify dev`) populates them for you.
# URL
# DEPLOY_PRIME_URL
# NETLIFY_DEV
# CONTEXT
# NODE_ENV
