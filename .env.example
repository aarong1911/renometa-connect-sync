# Google Ads OAuth (server-only — do not prefix with VITE_)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_OAUTH_STATE_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# App-facing URL the callback redirects the browser back to after OAuth
# finishes — must resolve to an allowed origin (http://localhost:5173 or
# https://connect.renometa.com only; port 9999 is the Netlify Functions
# server, NOT the frontend, and is deliberately not accepted here). Falls
# back to CONNECT_APP_URL, then a safe production default, if unset — but
# CONNECT_APP_URL is commonly set to http://localhost:9999 for local
# `netlify dev`, which is NOT in the allowlist, so local testing needs this
# var set explicitly:
#   Local:      GOOGLE_ADS_POST_CONNECT_URL=http://localhost:5173/settings/integrations
#   Production: GOOGLE_ADS_POST_CONNECT_URL=https://connect.renometa.com/settings/integrations
GOOGLE_ADS_POST_CONNECT_URL=
# Optional — Google Ads API version used for account discovery. Defaults to
# v25 if unset (see netlify/functions/lib/google-ads-api.ts).
GOOGLE_ADS_API_VERSION=
